# Copy to .env and fill in. .env is git-ignored.
# Every value here is read by the Testcontainers environment or by the LLM client.

# --- Model provider (local by default) ---------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_JUDGE_MODEL=bespoke-minicheck

# Optional hosted providers for reference runs. Leave empty to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- System under test (Dify) ----------------------------------------------
DIFY_BASE_URL=http://localhost/v1
DIFY_IMAGE_TAG=1.6.0
DIFY_API_KEY_GROUNDING=
DIFY_API_KEY_STRUCTURED=
DIFY_API_KEY_AGENT=

# --- Run policy overrides (defaults live in ARCHITECTURE.md §3) --------------
ASSAY_RUNS_GROUNDING=5
ASSAY_RUNS_STRUCTURED=5
ASSAY_RUNS_AGENT=10
ASSAY_PROFILE=local
